{
  "name": "p2v_geometry_face_control_20260823",
  "description": "Training-free geometry-control prototype: replace generic DWPose face landmarks with reference-person InsightFace 3D-68 landmarks re-posed to the driving head orientation, then test with/without mild reference K/V guidance.",
  "cwd": "/data1/workspace/linxinliang/CoInteract",
  "npu": "7",
  "env": {
    "PYTHONUNBUFFERED": "1",
    "TOKENIZERS_PARALLELISM": "false",
    "PYTORCH_NPU_ALLOC_CONF": "max_split_size_mb:256,garbage_collection_threshold:0.8"
  },
  "log_dir": "logs/p2v_geometry_face_control_20260823",
  "python_executable": "/data1/miniconda3/envs/cointeract/bin/python",
  "batch_infer": "batch_infer.py",
  "base_batch_args": {
    "base_model_path": "./models/Wan2.2-S2V-14B",
    "audio_encoder_path": "./models/chinese-wav2vec2-large",
    "height": 832,
    "width": 480,
    "num_frames": 80,
    "num_clips": 1,
    "num_inference_steps": 40,
    "cfg_scale": 7.0,
    "sigma_shift": 7.0,
    "lora_path": "./models/CoInteract/checkpoint_pose.safetensors",
    "reference_compose_mode": "stretch"
  },
  "base_batch_flags": [
    "no_resize_output_to_reference"
  ],
  "variants": [
    {
      "name": "00_motion1_origpose_baseline",
      "runner": "batch_infer",
      "args": {
        "csv_path": "examples/p2v_geometry_face_control_20260823_motion1_orig.csv",
        "output_dir": "output_videos/p2v_geometry_face_control_20260823/00_motion1_origpose_baseline"
      }
    },
    {
      "name": "01_motion1_idface_baseline",
      "runner": "batch_infer",
