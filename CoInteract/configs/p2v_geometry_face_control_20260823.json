      }
    },
    {
      "name": "02_motion1_idface_refkv005",
      "runner": "batch_infer",
      "args": {
        "csv_path": "examples/p2v_geometry_face_control_20260823_motion1_idface.csv",
        "output_dir": "output_videos/p2v_geometry_face_control_20260823/02_motion1_idface_refkv005",
        "reference_kv_guidance_scale": 0.05,
        "reference_kv_guidance_mode": "head_attn",
        "reference_kv_guidance_blocks": "10:22",
        "reference_kv_guidance_start_t": 0.05,
        "reference_kv_guidance_end_t": 0.75
