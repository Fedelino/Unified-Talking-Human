#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${REPO_ROOT}"

export ASCEND_RT_VISIBLE_DEVICES="${ASCEND_RT_VISIBLE_DEVICES:-6}"
export CUDA_VISIBLE_DEVICES=""
export PYTORCH_NPU_ALLOC_CONF="${PYTORCH_NPU_ALLOC_CONF:-max_split_size_mb:256,garbage_collection_threshold:0.8}"
export CONSISID=1

BASE_MODEL_PATH="./models/Wan2.2-S2V-14B"
AUDIO_ENCODER_PATH="./models/chinese-wav2vec2-large"
export IMAGE_ENCODER_PATH="${IMAGE_ENCODER_PATH:-/data1/Wan-AI/wan21_14b_480p/models_clip_open-clip-xlm-roberta-large-vit-huge-14.pth}"
TOKENIZER_PATH="${BASE_MODEL_PATH}/google/umt5-xxl"
DATASET_BASE_PATH="./data/ubcfashion_tiktok_pose_full"
DATASET_CSV="${DATASET_BASE_PATH}/data.csv"
OUTPUT_PATH="${OUTPUT_PATH:-./output/consisid_v1}"

export AUDIO_ENCODER_DIR="${AUDIO_ENCODER_PATH}"
export TOKENIZER_DIR="${TOKENIZER_PATH}"
export ARC_FACE_ONNX="${ARC_FACE_ONNX:-models/arcface/w600k_r50.onnx}"

# Wan-S2V is much wider than the original ConsisID CogVideoX backbone. The
# full faithful adapter is too large for one 60GB NPU, so default to a
# memory-safe ConsisID variant unless explicitly overridden.
export CONSISID_INTERVAL="${CONSISID_INTERVAL:-8}"
export CONSISID_START_BLOCK="${CONSISID_START_BLOCK:-32}"
export CONSISID_EXTRACTOR_DEPTH="${CONSISID_EXTRACTOR_DEPTH:-1}"
export CONSISID_NUM_QUERIES="${CONSISID_NUM_QUERIES:-4}"
export CONSISID_ID_TOKEN_DIM="${CONSISID_ID_TOKEN_DIM:-512}"
export CONSISID_CROSS_HEADS="${CONSISID_CROSS_HEADS:-4}"
export CONSISID_CROSS_DIM_HEAD="${CONSISID_CROSS_DIM_HEAD:-32}"

MODEL_PATHS="[
  \"${BASE_MODEL_PATH}/models_t5_umt5-xxl-enc-bf16.pth\",
  \"${BASE_MODEL_PATH}/Wan2.1_VAE.pth\",
  \"${AUDIO_ENCODER_PATH}/pytorch_model.bin\",
  [
    \"${BASE_MODEL_PATH}/diffusion_pytorch_model-00001-of-00004.safetensors\",
    \"${BASE_MODEL_PATH}/diffusion_pytorch_model-00002-of-00004.safetensors\",
    \"${BASE_MODEL_PATH}/diffusion_pytorch_model-00003-of-00004.safetensors\",
    \"${BASE_MODEL_PATH}/diffusion_pytorch_model-00004-of-00004.safetensors\"
  ]
]"

test -f "${DATASET_CSV}" || {
  echo "Missing ${DATASET_CSV}. Run: bash scripts/prepare_ubcfashion_tiktok_pose_mix.sh" >&2
  exit 1
}
test -f "${IMAGE_ENCODER_PATH}" || {
  echo "Missing image encoder: ${IMAGE_ENCODER_PATH}" >&2
  exit 1
}
test -f "${ARC_FACE_ONNX}" || {
  echo "Missing ArcFace ONNX: ${ARC_FACE_ONNX}" >&2
  exit 1
}

GC_OFFLOAD_ARGS=()
if [ "${USE_GC_OFFLOAD:-1}" = "1" ]; then
  GC_OFFLOAD_ARGS+=(--use_gradient_checkpointing_offload)
fi

python train_consisid.py \
  --model_paths "${MODEL_PATHS}" \
  --dataset_metadata_path "${DATASET_CSV}" \
  --dataset_base_path "${DATASET_BASE_PATH}" \
  --output_path "${OUTPUT_PATH}" \
  --height 480 \
  --width 320 \
  --num_frames 81 \
  --extra_inputs "person_image" \
  --trainable_models "" \
  --pose_dropout_prob 0.1 \
  "${GC_OFFLOAD_ARGS[@]}" \
  --train_shift 5.0 \
  --learning_rate 1e-4 \
  --num_epochs "${NUM_EPOCHS:-5}" \
  --save_steps "${SAVE_STEPS:-100}" \
  --gradient_accumulation_steps 1 \
  --dataset_num_workers 0
